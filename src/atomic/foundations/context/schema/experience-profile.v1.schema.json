{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hayzoui:schema:experience-profile:1",
  "title": "HayzoUI Experience Profile v1",
  "description": "A versioned composition of visual system, brand theme, context preset, and explicit environment defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "visualSystem",
    "brandTheme",
    "contextPreset"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "visualSystem": {
      "$ref": "#/definitions/versionedReference"
    },
    "brandTheme": {
      "$ref": "#/definitions/versionedReference"
    },
    "contextPreset": {
      "$ref": "#/definitions/versionedReference"
    },
    "context": {
      "$ref": "#/definitions/contextOverrides"
    }
  },
  "definitions": {
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "contextOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "numberingSystem": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,8}(?:-[a-z0-9]{3,8})*$"
        },
        "calendar": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,8}(?:-[a-z0-9]{3,8})*$"
        },
        "density": {
          "enum": [
            "compact",
            "default",
            "touch"
          ]
        },
        "motion": {
          "enum": [
            "full",
            "reduced"
          ]
        },
        "contrast": {
          "enum": [
            "normal",
            "more",
            "forced"
          ]
        },
        "inputModality": {
          "enum": [
            "unknown",
            "pointer",
            "touch",
            "keyboard",
            "assistive"
          ]
        },
        "mixedScriptAlignment": {
          "enum": [
            "ui",
            "content"
          ]
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:UTC|GMT|[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*)$"
        },
        "firstDayOfWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "defaultCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
