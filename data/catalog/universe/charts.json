    "features": [
      {
        "id": "rtl-axes",
        "name": {
          "ar": "محاور RTL: الأصل يمينًا ومحور القيم عند بداية السطر",
          "en": "Axes for RTL: origin on the right, value axis on the inline start"
        },
        "priority": "p0",
        "in": [
          "mui-x",
          "mantine"
        ],
        "arabic": {
          "kind": "opportunity",
          "note": {
            "ar": "محاور الزمن والفئات تمتد من اليمين إلى اليسار في التقارير العربية، ومصفوفة المالك تعدّ محاور RTL والأرقام العربية في العلامات فرصة",
            "en": "Time and category axes run right to left in Arabic reports; the owner's matrix lists RTL axes and Arabic numerals in tick labels as an opening"
          }
        },
        "origin": "authored",
        "evidence": [
          {
            "library": "mui-x",
            "symbol": "reverse",
            "path": "@mui/x-charts/ChartsLabel/ChartsLabelGradient.d.ts"
          },
