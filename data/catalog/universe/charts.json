        "priority": "p0",
        "in": [
          "mui-x",
          "mantine"
        ],
        "arabic": {
          "kind": "requirement",
          "note": {
            "ar": "الأرقام تُعرض بنظام أرقام النطاق (لاتينية أو هندية) بمعزل عن اللغة",
