    "rtlDecisions": [
      {
        "id": "color-area-arrows",
        "question": "Is a two-dimensional colour area (and its hue or alpha strip) mirrored in RTL, with its horizontal arrows?",
        "apg": "No colour picker page.",
        "libraries": [
          {
            "library": "react-aria",
            "behaviour": "Mirrors: in RTL ArrowLeft increments the x channel, the pointer x is inverted, and Home and End swap (Home increments x by a page step).",
            "evidence": "packages/react-aria/src/color/useColorArea.ts",
            "checked": "source-read"
          }
        ],
        "recommendation": "none",
        "reason": "A colour plane is a picture of a colour space, not a reading-order control: mirroring it changes where every colour sits relative to other tools. Keep the plane and its strips physical, with ArrowRight always increasing the x channel, and expose an opt-in to mirror. React Aria takes the opposite view; this needs a decision by a designer who works in Arabic.",
        "status": "open"
      }
    ],
    "verification": {
      "keyboard": "needs-review",
      "arabicName": "needs-review",
      "rtl": "needs-review"
    },
    "notes": "RTL is an open decision (color-area-arrows). React Aria mirrors the area: in RTL ArrowLeft increments x, the pointer mapping is inverted, and Home and End swap. We record the bindings as not mirrored, on the argument that the colour plane is a picture and should match other tools, and flag them debatable; whichever way it is decided, the strip and the area must agree with each other, and Home/End must follow the arrows. Hex values are always left-to-right (isolate the field). The swatch list, by contrast, is ordinary content: a horizontal or grid listbox whose arrows mirror."
