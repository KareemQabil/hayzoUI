    "reference": {
      "name": "APG: Accordion Pattern (Sections With Show/Hide Functionality)",
      "url": "https://www.w3.org/WAI/ARIA/apg/patterns/accordion/"
    },
    "roles": [
      {
        "role": "heading",
        "on": "wrapper of each header button",
        "required": true,
        "note": "A native heading element is preferred; the button is its only child."
      },
      {
        "role": "button",
        "on": "accordion header",
        "required": true
      },
      {
        "role": "region",
        "on": "panel",
        "required": false,
        "note": "Avoid when more than about six panels can be open at once."
      }
    ],
    "attributes": [
      {
        "name": "aria-level",
        "on": "heading",
        "values": "integer matching the page outline",
        "required": true
      },
      {
        "name": "aria-expanded",
        "on": "header button",
        "values": "true | false",
        "required": true
      },
      {
        "name": "aria-controls",
        "on": "header button",
        "values": "IDREF of its panel",
        "required": true
      },
      {
        "name": "aria-disabled",
        "on": "header button of an open panel that may not be collapsed",
        "values": "true",
        "required": false
      },
      {
        "name": "aria-labelledby",
        "on": "panel with role region",
        "values": "IDREF of its header button",
        "required": false
      }
    ],
    "keyboard": [
      {
        "keys": [
          "Enter",
          "Space"
        ],
        "action": "On the header of a collapsed panel: expand it; if only one panel may be open, collapse the other. On the header of an expanded panel: collapse it, if collapsing is allowed.",
        "directionSensitive": false,
        "rtl": "none",
        "origin": "apg"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "Move to the next focusable element; every header and every focusable element in open panels is in the page sequence.",
        "directionSensitive": false,
        "rtl": "none",
        "origin": "apg"
      },
      {
        "keys": [
          "Shift+Tab"
        ],
        "action": "Move to the previous focusable element in the page sequence.",
        "directionSensitive": false,
        "rtl": "none",
        "origin": "apg"
      }
    ],
    "focus": {
      "strategy": "native-tab",
      "entry": "Each header is its own tab stop.",
      "exit": "Tab leaves in page order.",
      "restore": "Focus stays on the header after toggling.",
      "tabStops": "One per header, plus the focusable content of open panels."
