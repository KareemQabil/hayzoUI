    "rtlDecisions": [
      {
        "id": "submenu-open-close",
        "question": "Which arrow opens a submenu from a vertical menu, and which closes it, in RTL?",
        "apg": "Silent. No pattern page mentions right-to-left; keys are described physically (left, right) for a left-to-right layout. Right Arrow opens a submenu, Left Arrow closes it.",
        "libraries": [
          {
            "library": "react-aria",
            "behaviour": "In RTL ArrowLeft opens the submenu and ArrowRight closes it.",
            "evidence": "packages/react-aria/src/menu/useSubmenuTrigger.ts",
            "checked": "source-read"
          },
          {
            "library": "radix",
            "behaviour": "SUB_OPEN_KEYS and SUB_CLOSE_KEYS are keyed by direction: rtl opens with ArrowLeft, closes with ArrowRight.",
            "evidence": "packages/react/menu/src/menu.tsx",
            "checked": "source-read"
          },
          {
            "library": "base-ui",
            "behaviour": "List navigation takes an rtl flag; the cross-orientation open and close keys are ArrowLeft and ArrowRight respectively when rtl.",
            "evidence": "packages/react/src/utils/popups/interactions/useListNavigation.ts, packages/react/src/menu/root/MenuRoot.tsx",
            "checked": "source-read"
          },
          {
            "library": "ant-design",
            "behaviour": "In a vertical menu Left means \"children\" (open) and Right means \"parent\" (close) when rtl.",
            "evidence": "@rc-component/menu es/hooks/useAccessibility.js",
            "checked": "source-read"
          }
        ],
        "recommendation": "mirror-horizontal",
        "reason": "A submenu opens toward inline-end, which is the left in RTL; the arrow must point where the submenu appears.",
        "status": "consensus"
      }
    ],
    "verification": {
      "keyboard": "needs-review",
      "arabicName": "needs-review",
      "rtl": "verified"
    },
    "notes": "Everything after opening is the menu pattern. A context menu must never be the only way to reach a command. RTL: opened by keyboard, the menu is anchored at the inline-start corner of the target (top right in RTL) and submenus open leftward, so ArrowLeft opens and ArrowRight closes. \"ContextMenu\" is the KeyboardEvent.key value of the menu key."
  }
