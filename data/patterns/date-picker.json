        "rtl": "none",
        "group": "field",
        "origin": "apg"
      },
      {
        "keys": [
          "Alt+ArrowDown"
        ],
        "action": "From the field: open the calendar.",
        "directionSensitive": false,
        "rtl": "none",
        "group": "field",
        "origin": "react-aria"
      },
      {
        "keys": [
          "Escape"
        ],
        "action": "Close the dialog without changing the value and return focus to the calendar button.",
        "directionSensitive": false,
        "rtl": "none",
        "group": "dialog",
        "origin": "apg"
      },
      {
        "keys": [
          "Tab"
        ],
        "action": "Cycle through the dialog: navigation buttons, the grid (one stop), then any confirm and cancel buttons, wrapping.",
        "directionSensitive": false,
        "rtl": "none",
        "group": "dialog",
        "origin": "apg"
      },
      {
        "keys": [
          "Shift+Tab"
        ],
        "action": "Cycle backward through the dialog.",
        "directionSensitive": false,
        "rtl": "none",
        "group": "dialog",
        "origin": "apg"
      },
      {
        "keys": [
          "Enter",
          "Space"
        ],
        "action": "On a date: select it, close the dialog, update the field and return focus to the calendar button.",
        "directionSensitive": false,
        "rtl": "none",
        "group": "dialog",
        "origin": "apg"
      }
    ],
    "focus": {
      "strategy": "focus-trap",
      "entry": "Into the grid, on the selected date or today.",
      "exit": "Escape, selecting a date, or the cancel button.",
      "restore": "To the calendar button (APG) or the field.",
      "tabStops": "Closed: the field's segments and the button. Open: trapped in the dialog."
