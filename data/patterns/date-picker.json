    "id": "date-picker",
    "name": {
      "ar": "منتقي التاريخ",
      "en": "Date picker"
    },
    "reference": {
      "name": "APG example: Date Picker Dialog",
      "url": "https://www.w3.org/WAI/ARIA/apg/patterns/dialog-modal/examples/datepicker-dialog/"
    },
    "roles": [
      {
        "role": "group",
        "on": "field and button together",
        "required": true
      },
      {
        "role": "spinbutton",
        "on": "date segments (segmented variant)",
        "required": false
      },
      {
        "role": "button",
        "on": "the control that opens the calendar",
        "required": true
      },
      {
        "role": "dialog",
        "on": "the calendar popup",
        "required": true
      },
      {
        "role": "grid",
        "on": "the calendar",
        "required": true
      }
    ],
    "attributes": [
      {
        "name": "aria-haspopup",
        "on": "button",
        "values": "dialog",
        "required": true
      },
      {
        "name": "aria-expanded",
        "on": "button",
        "values": "true | false",
        "required": true
      },
      {
        "name": "aria-label",
        "on": "button",
        "values": "action name that includes the selected date once there is one",
        "required": true
      },
      {
        "name": "aria-modal",
        "on": "dialog",
        "values": "true",
        "required": true
      },
      {
        "name": "aria-label",
        "on": "dialog",
        "values": "localized \"choose date\"",
        "required": true
      }
    ],
    "keyboard": [
      {
        "keys": [
          "Enter",
          "Space"
        ],
        "action": "On the calendar button: open the dialog and focus the selected date, or today when none is selected.",
