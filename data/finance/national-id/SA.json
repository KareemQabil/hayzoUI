    "region": "SA",
    "dataset": "national-id",
    "identifier": {
      "en": "National ID number (citizens) and Iqama number (residents)"
    },
    "structure": {
      "length": 10,
      "pattern": "^[12][0-9]{9}$",
      "charset": "digits",
      "checksum": {
        "algorithm": "Luhn",
        "description": "Standard Luhn (mod 10) over all 10 digits."
      },
      "segments": [
        {
          "name": "type",
          "start": 0,
          "length": 1,
          "values": {
            "1": "Saudi citizen (national ID)",
            "2": "resident (iqama)"
          }
        },
        {
          "name": "serial",
          "start": 1,
          "length": 8
        },
        {
          "name": "checkDigit",
          "start": 9,
          "length": 1
        }
      ],
      "example": "1000000008"
    },
    "validation": {
      "origin": "reverse-engineered",
      "normalize": "Remove spaces. Convert Arabic-Indic digits to ASCII.",
      "steps": [
        "Must be exactly 10 digits.",
        "First digit must be 1 (citizen) or 2 (resident).",
        "Luhn: from the rightmost digit moving left, double every second digit; subtract 9 from any result above 9; add all digits; the total must be divisible by 10."
      ],
      "testVectors": [
        {
          "input": "1000000008",
          "valid": true,
          "note": "synthetic citizen-type number"
        },
        {
          "input": "2000000006",
          "valid": true,
          "note": "synthetic resident-type number"
        },
        {
          "input": "1000000009",
          "valid": false,
          "note": "check digit changed"
        },
        {
          "input": "3000000008",
          "valid": false,
          "note": "first digit not 1 or 2"
        }
      ]
    },
    "derivable": [
      "holder type: citizen or resident"
    ],
