      {
        "key": "qr.required",
        "value": "Mandatory on electronic tax invoices; printed as a QR image whose payload is a Base64 string of at most 700 characters",
        "asOf": "2026-11-11",
        "confidence": "verified",
        "sources": [
          {
            "name": "ZATCA: Security Features Implementation Standards",
            "url": "https://zatca.gov.sa/ar/E-Invoicing/SystemsDevelopers/Documents/20230519_ZATCA_Electronic_Invoice_Security_Features_Implementation_Standards_vF.pdf",
            "version": "1.2 (2023-05-19)",
            "license": "Government publication, facts only",
            "retrievedAt": "2026-11-11",
            "path": "Section 4.1 Structure of the QR code"
          }
        ]
      },
      {
        "key": "qr.encoding",
        "value": {
          "container": "TLV (tag-length-value), all fields concatenated in ascending tag order, then Base64-encoded; the QR image encodes the Base64 ASCII string",
          "tag": "one byte holding the tag number",
          "length": "one byte, unsigned, the number of bytes of the value (so a value cannot exceed 255 bytes)",
          "value": "tags 1-5: UTF-8 bytes of the field text. Tag 6: the 32 raw bytes of the SHA-256 hash, as the standard words it. Tags 7-9: the byte array of the value",
          "order": [
            "start with an empty byte array",
            "for each field append tag byte, length byte, value bytes",
            "Base64-encode the whole array",
            "render the Base64 string as a QR code"
          ],
          "tags": [
            {
              "tag": 1,
              "field": "Seller name",
              "from": "2021-12-04"
            },
            {
              "tag": 2,
              "field": "VAT registration number of the seller",
              "from": "2021-12-04"
            },
            {
              "tag": 3,
              "field": "Time stamp of the invoice, ISO 8601 date and time, e.g. 2022-02-21T12:13:57Z",
              "from": "2021-12-04"
            },
            {
              "tag": 4,
              "field": "Invoice total with VAT",
              "from": "2021-12-04"
            },
            {
              "tag": 5,
              "field": "VAT total (business term BT-110 of the XML invoice)",
              "from": "2021-12-04"
            },
            {
              "tag": 6,
              "field": "Hash of the XML invoice (SHA-256)",
              "from": "2023-01-01"
            },
            {
              "tag": 7,
              "field": "ECDSA signature of the XML hash",
              "from": "2023-01-01"
            },
            {
              "tag": 8,
              "field": "ECDSA public key extracted from the signing private key",
              "from": "2023-01-01"
            },
            {
              "tag": 9,
              "field": "Simplified tax invoices and their notes only: ECDSA signature of the cryptographic stamp, issued by ZATCA’s technical CA (the wording in the standard is truncated; commonly read as the CA signature over the stamp’s public key)",
              "from": "2023-01-01"
            }
          ]
        },
        "asOf": "2026-11-11",
        "confidence": "verified",
        "sources": [
          {
            "name": "ZATCA: Security Features Implementation Standards",
            "url": "https://zatca.gov.sa/ar/E-Invoicing/SystemsDevelopers/Documents/20230519_ZATCA_Electronic_Invoice_Security_Features_Implementation_Standards_vF.pdf",
