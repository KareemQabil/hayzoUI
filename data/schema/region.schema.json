{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region.schema.json",
  "title": "Region",
  "description": "One country or territory: everything locale-dependent that is not language. File: data/regions/<ISO2>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "region"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "alpha3": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "numeric": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "nameVariants": {
          "description": "Other names CLDR gives the territory (alt=\"short\").",
          "type": "object",
          "properties": {
            "short": {
              "$ref": "common.schema.json#/$defs/localized"
            }
          },
          "additionalProperties": false
        },
        "officialName": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "arabLeague": {
          "type": "boolean"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "official",
                  "official-regional",
                  "national",
                  "widely-used"
                ]
              },
              "cldrStatus": {
                "description": "officialStatus in CLDR territoryInfo, verbatim.",
                "enum": [
                  "official",
                  "de_facto_official",
                  "official_regional",
                  "official_minority"
                ]
              },
              "populationPercent": {
                "description": "Share of the population that uses the language, per CLDR territoryInfo.",
                "type": "number"
              }
            },
            "required": [
              "code",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1,
                "description": "BCP 47, e.g. ar-EG."
              },
              "primary": {
                "type": "boolean"
              },
              "defaultNumberingSystem": {
                "description": "What CLDR uses for this locale by default.",
                "enum": [
                  "arab",
                  "latn"
                ]
              },
              "nativeNumberingSystem": {
                "enum": [
                  "arab",
                  "latn"
                ]
              },
              "hourCycle": {
                "enum": [
                  "h11",
                  "h12",
                  "h23",
                  "h24"
                ]
              },
              "gregorianMonthNames": {
                "description": "english-derived: يناير. syriac: كانون الثاني. french-derived: جانفي.",
                "enum": [
                  "english-derived",
                  "syriac",
                  "french-derived",
                  "mixed"
                ]
              },
              "monthNamesSharedWith": {
                "description": "Only when gregorianMonthNames is mixed: how many of the 12 wide month names equal those of each family.",
                "type": "object",
                "properties": {
                  "english-derived": {
                    "type": "integer"
                  },
                  "syriac": {
                    "type": "integer"
                  },
                  "french-derived": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "tag",
              "primary",
              "defaultNumberingSystem"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "otherLocales": {
          "description": "Locales of other languages that CLDR ships for the region (availableLocales full, plus defaultContent).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "currency": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "alsoUsed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "required": [
            "primary"
          ],
          "additionalProperties": false
        },
        "week": {
          "type": "object",
          "properties": {
            "firstDay": {
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            },
            "weekend": {
              "type": "array",
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              "minItems": 1
            },
            "minDaysInFirstWeek": {
              "type": "integer"
            }
          },
          "required": [
            "firstDay",
            "weekend"
          ],
          "additionalProperties": false
        },
        "calendars": {
          "description": "Calendar identifiers in order of preference.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "timeZones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tzdbLinks": {
          "description": "Zones in timeZones that tzdb keeps only as a Link in its backward file, with the Zone each points to.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeData": {
          "description": "CLDR timeData for the region: pattern symbols for the preferred and allowed hour formats (h, H, hb, hB).",
          "type": "object",
          "properties": {
            "preferred": {
              "type": "string",
              "minLength": 1
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "preferred",
            "allowed"
          ],
          "additionalProperties": false
        },
        "measurementSystem": {
          "enum": [
            "metric",
            "US",
            "UK"
          ]
        },
        "paperSize": {
          "enum": [
            "A4",
            "US-Letter"
          ]
        },
        "phone": {
          "type": "object",
          "properties": {
            "callingCode": {
              "type": "string",
              "pattern": "^[0-9]{1,4}$"
            }
          },
          "required": [
            "callingCode"
          ],
          "additionalProperties": false
        },
        "dialectGroup": {
          "enum": [
            "egyptian",
            "gulf",
            "levantine",
            "mesopotamian",
            "maghrebi",
            "sudanese",
            "yemeni",
            "other"
          ]
        },
        "worldDefaults": {
          "description": "Fields CLDR does not state for this region; the value is the one CLDR gives territory 001.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fieldProvenance": {
          "description": "Fields whose method or confidence differs from the file-level provenance. The file-level values describe everything not listed here.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Dot path inside data."
              },
              "method": {
                "enum": [
                  "extracted",
                  "derived",
                  "researched",
                  "authored"
                ]
              },
              "confidence": {
                "$ref": "common.schema.json#/$defs/confidence"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/source"
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "method",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "alpha3",
        "name",
        "locales",
        "currency",
        "week",
        "calendars",
        "timeZones",
        "phone"
      ],
      "additionalProperties": false
    }
  }
}
