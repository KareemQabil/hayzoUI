{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "Component (universe entry)",
  "description": "One canonical component of the universe we intend to cover, with its names elsewhere, its behaviour and its Arabic requirements. File: data/catalog/universe/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "component"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "family": {
          "enum": [
            "action",
            "text-input",
            "numeric-input",
            "choice",
            "selection",
            "date-time",
            "overlay",
            "navigation",
            "layout",
            "display",
            "feedback",
            "data",
            "media",
            "utility",
            "pattern"
          ]
        },
        "tier": {
          "description": "Build order by dependency: T0 foundations … T5 specialised.",
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5"
          ]
        },
        "priority": {
          "$ref": "common.schema.json#/$defs/priority"
        },
        "engines": {
          "description": "Headless engines it is built on, from the closed list in docs/ARCHITECTURE.md (\"none\" when it needs no engine). tools/extract/universe/report.mjs checks every id against that list.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "patterns": {
          "description": "Behaviour pattern ids (data/patterns).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Named parts, in reading order."
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Ids of other universe components this one is built from. Every id must resolve (checked by tools/extract/universe/report.mjs).",
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "library": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "library",
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Names of this component in other libraries. Every alias was checked against the library's published exports (or the shadcn registry index); names that could not be checked are left out."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "priority": {
                "$ref": "common.schema.json#/$defs/priority"
              },
              "in": {
                "description": "Library ids that ship this feature.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              },
              "arabic": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "requirement",
                      "risk",
                      "opportunity"
                    ]
                  },
                  "note": {
                    "$ref": "common.schema.json#/$defs/localized"
                  }
                },
                "required": [
                  "kind",
                  "note"
                ],
                "additionalProperties": false
              },
              "origin": {
                "description": "Where the row and its Arabic name come from: the owner's parity matrix (citable source) or written for this file (needs review).",
                "enum": [
                  "owner-matrix",
                  "authored"
                ]
              },
              "evidence": {
                "description": "For libraries of `in` that were confirmed mechanically: the property found in that library's type declarations (or source, for shadcn). A library listed in `in` without evidence is asserted from the owner's matrix or from knowledge of the library and needs review.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "library": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "library",
                    "symbol"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "arabic": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "decisions": {
          "description": "Judgement calls made for this entry, stated so they can be challenged.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "enum": [
                  "naming",
                  "merge",
                  "split",
                  "tier",
                  "engine",
                  "scope"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "topic",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "summary",
        "family",
        "tier",
        "priority",
        "engines",
        "aliases",
        "features"
      ],
      "additionalProperties": false
    }
  }
}
