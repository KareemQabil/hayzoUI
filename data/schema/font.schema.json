{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "font.schema.json",
  "title": "Typeface",
  "description": "One open-licensed typeface that covers Arabic, with the metrics a UI needs. File: data/fonts/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "font"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "sans",
            "naskh",
            "kufi",
            "geometric",
            "monospace",
            "display",
            "ruqaa",
            "nastaliq"
          ]
        },
        "designers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "npm": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "italic": {
          "type": "boolean"
        },
        "variable": {
          "type": "object",
          "properties": {
            "axes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "default": {
                    "type": "number"
                  }
                },
                "required": [
                  "tag",
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "unitsPerEm": {
              "type": "integer"
            },
            "hhea": {
              "type": "object",
              "properties": {
                "ascender": {
                  "type": "integer"
                },
                "descender": {
                  "type": "integer"
                },
                "lineGap": {
                  "type": "integer"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "typo": {
              "type": "object",
              "properties": {
                "ascender": {
                  "type": "integer"
                },
                "descender": {
                  "type": "integer"
                },
                "lineGap": {
                  "type": "integer"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "win": {
              "type": "object",
              "properties": {
                "ascent": {
                  "type": "integer"
                },
                "descent": {
                  "type": "integer"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "xHeight": {
              "type": "integer"
            },
            "capHeight": {
              "type": "integer"
            },
            "measuredFrom": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unitsPerEm"
          ],
          "additionalProperties": false
        },
        "arabic": {
          "type": "object",
          "properties": {
            "coversTashkeel": {
              "type": "boolean"
            },
            "digits": {
              "type": "object",
              "properties": {
                "arabicIndic": {
                  "type": "boolean"
                },
                "extendedArabicIndic": {
                  "type": "boolean"
                },
                "tabular": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "recommendedLineHeight": {
              "type": "object",
              "properties": {
                "ui": {
                  "type": "number"
                },
                "body": {
                  "type": "number"
                },
                "withTashkeel": {
                  "type": "number"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "latinCompanion": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "category",
        "license",
        "scripts",
        "weights"
      ],
      "additionalProperties": false
    }
  }
}
