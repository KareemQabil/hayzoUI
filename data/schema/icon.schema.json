{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icon.schema.json",
  "title": "Icon data",
  "description": "source-catalog: names, tags and categories of one open icon set. mirror-evidence: per-icon direction facts extracted mechanically from published sets. mirror-rules: which concepts flip in RTL and why. core-set: the icons our components need, mapped to each source. gaps: concepts an Arabic-first product needs that the catalogs lack. Files under data/icons/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "icon"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "required": [
        "dataset",
        "content"
      ],
      "properties": {
        "dataset": {
          "enum": [
            "source-catalog",
            "mirror-evidence",
            "mirror-rules",
            "core-set",
            "gaps"
          ]
        },
        "content": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "dataset": {
              "const": "source-catalog"
            },
            "content": {
              "$ref": "#/$defs/sourceCatalog"
            }
          }
        },
        {
          "properties": {
            "dataset": {
              "const": "mirror-evidence"
            },
            "content": {
              "$ref": "#/$defs/mirrorEvidence"
            }
          }
        },
        {
          "properties": {
            "dataset": {
              "const": "mirror-rules"
            },
            "content": {
              "$ref": "#/$defs/mirrorRules"
            }
          }
        },
        {
          "properties": {
            "dataset": {
              "const": "core-set"
            },
            "content": {
              "$ref": "#/$defs/coreSet"
            }
          }
        },
        {
          "properties": {
            "dataset": {
              "const": "gaps"
            },
            "content": {
              "$ref": "#/$defs/gaps"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "drawing": {
      "type": "object",
      "properties": {
        "model": {
          "enum": [
            "stroke",
            "fill"
          ]
        },
        "grid": {
          "type": "number"
        },
        "strokeWidth": {
          "type": "number"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "variableAxes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": false
    },
    "sourceCatalog": {
      "type": "object",
      "required": [
        "set",
        "icons"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "required": [
            "name",
            "repository",
            "npm",
            "version",
            "license",
            "iconCount",
            "drawing",
            "styles"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "npm": {
              "type": "string",
              "minLength": 1
            },
            "npmNote": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "object",
              "required": [
                "spdx",
                "file"
              ],
              "additionalProperties": false,
              "properties": {
                "spdx": {
                  "type": "string",
                  "minLength": 1
                },
                "copyright": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "iconCount": {
              "type": "integer",
              "minimum": 1
            },
            "metadata": {
              "type": "object",
              "description": "How many icons carry tags / categories.",
              "properties": {
                "tags": {
                  "type": "integer"
                },
                "categories": {
                  "type": "integer"
                }
              },
              "required": [
                "tags",
                "categories"
              ],
              "additionalProperties": false
            },
            "drawing": {
              "$ref": "#/$defs/drawing"
            },
            "styles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "iconCount"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "iconCount": {
                    "type": "integer"
                  },
                  "drawing": {
                    "$ref": "#/$defs/drawing"
                  }
                }
              }
            },
            "categoryIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "rtl": {
              "type": "object",
              "description": "Direction metadata the set itself publishes.",
              "required": [
                "mechanism"
              ],
              "properties": {
                "mechanism": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "figmaCategory": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "sizes": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "direction": {
                "enum": [
                  "mirror",
                  "unique"
                ]
              },
              "singleton": {
                "type": "string",
                "minLength": 1
              },
              "directionVariant": {
                "enum": [
                  "ltr",
                  "rtl"
                ]
              },
              "autoMirrored": {
                "type": "boolean"
              },
              "deprecated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "mirrorEvidence": {
      "type": "object",
      "required": [
        "lists"
      ],
      "additionalProperties": false,
      "properties": {
        "lists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "signal",
              "meaning",
              "count",
              "names"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "enum": [
                  "mirror",
                  "separate-rtl-artwork",
                  "mirror-legacy"
                ]
              },
              "count": {
                "type": "integer"
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "source",
        "says"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "says": {
          "enum": [
            "mirror",
            "never",
            "conditional",
            "separate-rtl-artwork",
            "not-mirrored"
          ]
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mirrorRules": {
      "type": "object",
      "required": [
        "sources",
        "principles",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "mechanical",
                  "guidance"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "verdict",
              "statement",
              "sources"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "verdict": {
                "enum": [
                  "auto",
                  "never",
                  "conditional"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "concept",
              "verdict",
              "reason",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "concept": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "verdict": {
                "enum": [
                  "auto",
                  "never",
                  "conditional"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "mechanical",
                  "guidance",
                  "authored"
                ]
              },
              "principles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidenceRef"
                }
              },
              "disagreement": {
                "type": "string",
                "minLength": 1
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "arabicSpecific": {
                "type": "boolean"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "coreSet": {
      "type": "object",
      "required": [
        "sourceIds",
        "concepts"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "group",
              "mirror",
              "sources"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "mirror": {
                "enum": [
                  "auto",
                  "never",
                  "conditional"
                ]
              },
              "mirrorRule": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "usedBy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "object",
      "required": [
        "gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status",
              "need",
              "search"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "status": {
                "enum": [
                  "missing",
                  "partial",
                  "poor",
                  "trademark"
                ]
              },
              "priority": {
                "$ref": "common.schema.json#/$defs/priority"
              },
              "need": {
                "type": "string",
                "minLength": 1
              },
              "unicode": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "search": {
                "type": "object",
                "required": [
                  "terms",
                  "hits"
                ],
                "additionalProperties": false,
                "properties": {
                  "terms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "hits": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "hitCounts": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
