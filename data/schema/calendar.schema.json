{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calendar.schema.json",
  "title": "Calendar system",
  "description": "One calendar: months, eras, how to convert, where it is official. File: data/calendar/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "calendar"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unicode calendar identifier: gregory, islamic-umalqura, islamic-civil, islamic-tbla, persian …"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "type": {
          "enum": [
            "solar",
            "lunar",
            "lunisolar"
          ]
        },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "abbreviation": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "days": {
                "description": "A number, or [min, max].",
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            },
            "required": [
              "index",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "eras": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "abbreviation": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "intl": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "runtimeSupport": {
              "type": "string",
              "minLength": 1
            },
            "range": {
              "type": "string",
              "minLength": 1
            },
            "caveats": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "identifier"
          ],
          "additionalProperties": false
        },
        "conversion": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "description": "Repo-relative path of a data table, when conversion is tabular.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        "officialIn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "months"
      ],
      "additionalProperties": false
    }
  }
}
