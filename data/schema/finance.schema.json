{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.schema.json",
  "title": "Finance and identity rules",
  "description": "One dataset for one region: VAT, e-invoicing, IBAN, national id, tax id … Every changeable fact is a claim with its own source and date. File: data/finance/<dataset>/<ISO2>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "finance"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "dataset": {
          "enum": [
            "vat",
            "e-invoicing",
            "iban",
            "national-id",
            "tax-id",
            "commercial-register",
            "cash-rounding",
            "bank-codes",
            "other"
          ]
        },
        "identifier": {
          "description": "What the identifier is called. Arabic is given only when taken from a cited source.",
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "structure": {
          "description": "For identifiers: how the value is built and checked.",
          "type": "object",
          "properties": {
            "length": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "charset": {
              "enum": [
                "digits",
                "alphanumeric",
                "other"
              ]
            },
            "checksum": {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "algorithm"
              ],
              "additionalProperties": false
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer"
                  },
                  "length": {
                    "type": "integer"
                  },
                  "meaning": {
                    "$ref": "common.schema.json#/$defs/localized"
                  },
                  "values": {
                    "type": "object"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "English description of the segment, for use where no authoritative Arabic wording is available for `meaning`."
                  }
                },
                "required": [
                  "name",
                  "start",
                  "length"
                ],
                "additionalProperties": false
              }
            },
            "example": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "validation": {
          "description": "How to validate the identifier, precise enough to implement and test from this file alone.",
          "type": "object",
          "properties": {
            "origin": {
              "description": "official: published by the issuing authority. specification: stated by a regulator’s technical standard. reverse-engineered: known only from open-source validators or secondary descriptions.",
              "enum": [
                "official",
                "specification",
                "reverse-engineered"
              ]
            },
            "normalize": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "testVectors": {
              "description": "Synthetic inputs only, never a real person’s or company’s number.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "valid": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "input",
                  "valid"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "origin",
            "steps"
          ],
          "additionalProperties": false
        },
        "derivable": {
          "description": "What can be read out of a valid identifier.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/claim"
              },
              {
                "properties": {
                  "key": {
                    "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
                  }
                }
              }
            ]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "region",
        "dataset"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dataset": {
                "const": "vat"
              }
            },
            "required": [
              "dataset"
            ]
          },
          "then": {
            "properties": {
              "claims": {
                "items": {
                  "properties": {
                    "key": {
                      "enum": [
                        "tax.exists",
                        "tax.type",
                        "tax.localName",
                        "rate.standard",
                        "rate.standard.effectiveFrom",
                        "rates.other",
                        "authority.name",
                        "taxNumber.localName",
                        "invoice.simplifiedThreshold"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
