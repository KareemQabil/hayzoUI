{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pattern.schema.json",
  "title": "Behaviour pattern",
  "description": "Keyboard, focus and ARIA contract of one interaction pattern, as structured data, with what changes in RTL. File: data/patterns/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "pattern"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "reference": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "on"
            ],
            "additionalProperties": false
          }
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "type": "boolean"
              },
              "directionSensitive": {
                "description": "True when the key means something different in RTL.",
                "type": "boolean"
              },
              "rtl": {
                "description": "mirror-horizontal: ArrowLeft and ArrowRight swap meaning.",
                "enum": [
                  "none",
                  "mirror-horizontal"
                ]
              }
            },
            "required": [
              "keys",
              "action",
              "directionSensitive"
            ],
            "additionalProperties": false
          }
        },
        "focus": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": [
                "native-tab",
                "roving-tabindex",
                "active-descendant",
                "focus-trap",
                "none"
              ]
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "exit": {
              "type": "string",
              "minLength": 1
            },
            "restore": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "strategy"
          ],
          "additionalProperties": false
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "reference",
        "roles",
        "keyboard",
        "focus"
      ],
      "additionalProperties": false
    }
  }
}
