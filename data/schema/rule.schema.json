{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule.schema.json",
  "title": "Interface rule",
  "description": "One rule an Arabic-first interface must follow, with the reason and how it is checked. File: data/rules/<ID>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "rule"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^R-[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "statement": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "rationale": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "area": {
          "enum": [
            "numerals",
            "bidi",
            "money",
            "phone",
            "date",
            "search",
            "typography",
            "icons",
            "layout",
            "input",
            "content",
            "flow",
            "accessibility",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Statements a machine can evaluate against rendered output, a parsed value or source code. At least one when present."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "good": {
                "type": "string",
                "minLength": 1
              },
              "bad": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problem": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "What goes wrong without the rule."
        },
        "context": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Where the rule applies."
        },
        "exceptions": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Cases the rule does not cover or deliberately excludes."
        },
        "origin": {
          "description": "harvested: taken from the owner's earlier repository, id kept. new: written in this phase from the references.",
          "enum": [
            "harvested",
            "new"
          ]
        },
        "status": {
          "description": "Review state. proposed: not yet accepted by the owner.",
          "enum": [
            "proposed",
            "in-review",
            "accepted"
          ]
        },
        "references": {
          "description": "Primary references the rule rests on; the text is re-expressed, never quoted at length.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "section": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "fixtures": {
          "description": "Fixture sets (data/fixtures/<id>.json), optionally '<set>#<case id>', that exercise the checks.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(#.+)?$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "area",
        "severity"
      ],
      "additionalProperties": false
    }
  }
}
