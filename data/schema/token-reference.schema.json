{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token-reference.schema.json",
  "title": "Design token reference",
  "description": "The scales another design system publishes (control heights per density, spacing, radius, type scale, colour ramps, motion), as a reference for our own decisions. File: data/tokens/reference/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "token-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "system": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name",
            "license"
          ],
          "additionalProperties": false
        },
        "scales": {
          "type": "object"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "system",
        "scales"
      ],
      "additionalProperties": false
    }
  }
}
