{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-report.schema.json",
  "title": "Field reports",
  "description": "Real Arabic/RTL defects reported against existing libraries, each reduced to the lesson it teaches. File: data/field-reports/<library>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "field-report"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "library": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "description": "Issue number in the library's tracker."
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "bidi",
                  "numerals",
                  "mirroring",
                  "layout",
                  "input",
                  "calendar",
                  "typography",
                  "keyboard",
                  "overlay-position",
                  "scroll",
                  "animation",
                  "locale-strings",
                  "other",
                  "value-direction",
                  "portal-direction",
                  "chart",
                  "style-engine",
                  "direction-api"
                ],
                "description": "Defect class. overlay-position: anchored popups placed or flipped on the wrong side. value-direction: sliders, progress, ranges, carousels, steppers, ratings whose value axis does not follow direction. keyboard: arrow/Home/End keys not swapped. mirroring: icons and glyphs not mirrored or wrongly mirrored. portal-direction: content rendered outside the tree loses dir or the direction context. scroll: scrollbars, scrollLeft, sticky and pinned columns, virtualisation. input: caret, alignment, masks, number and segmented fields. numerals: digit systems and number/date formatting. calendar: calendar grids, pickers, Hijri/Jalali systems. chart: axes, legends, tooltips in charts. animation: transitions and indicators moving the wrong way. style-engine: physical CSS properties, flipping plugins, specificity and build-time RTL transforms. direction-api: how direction is declared, detected, nested or switched. bidi: mixed-direction text, isolation, punctuation, truncation. layout: static placement of parts (padding, alignment, order). typography: fonts, line height, letter spacing, shaping. locale-strings: missing or untranslated built-in strings."
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "open",
                  "closed",
                  "unknown"
                ]
              },
              "stateReason": {
                "enum": [
                  "completed",
                  "not_planned",
                  "duplicate",
                  "reopened"
                ],
                "description": "GitHub's reason for the current state, when it records one."
              },
              "createdAt": {
                "type": "string",
                "format": "date"
              },
              "closedAt": {
                "type": "string",
                "format": "date"
              },
              "daysOpen": {
                "type": "integer",
                "minimum": 0,
                "description": "Days from creation to close; for an open issue, days from creation to the retrieval date of the file's source."
              },
              "comments": {
                "type": "integer",
                "minimum": 0
              },
              "reactions": {
                "type": "integer",
                "minimum": 0,
                "description": "Total reactions on the issue body."
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "resolution": {
                "type": "string",
                "minLength": 1,
                "description": "How it ended, in our words: fixed and how, declined and why, worked around, or still waiting."
              },
              "fixedBy": {
                "type": "array",
                "description": "Merged pull requests of the same repository whose title or body names this issue after a closing keyword (closes/fixes/resolves #n). Found mechanically from the pull-request search; absent when none was found, which does not mean the issue was not fixed.",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mergedAt": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "required": [
                    "url"
                  ],
                  "additionalProperties": false
                }
              },
              "lesson": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "$ref": "common.schema.json#/$defs/confidence"
              }
            },
            "required": [
              "url",
              "title",
              "category",
              "summary",
              "lesson"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "library",
        "reports"
      ],
      "additionalProperties": false
    }
  }
}
