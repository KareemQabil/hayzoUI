{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "currency.schema.json",
  "title": "Currency",
  "description": "One ISO 4217 currency with what Arabic interfaces need to write, round and speak it. File: data/currencies/<ISO>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "currency"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "numeric": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "plural": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "object",
              "properties": {
                "zero": {
                  "type": "string",
                  "minLength": 1
                },
                "one": {
                  "type": "string",
                  "minLength": 1
                },
                "two": {
                  "type": "string",
                  "minLength": 1
                },
                "few": {
                  "type": "string",
                  "minLength": 1
                },
                "many": {
                  "type": "string",
                  "minLength": 1
                },
                "other": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "one",
                "two",
                "few",
                "many",
                "other"
              ],
              "additionalProperties": false
            },
            "arStated": {
              "description": "The count categories CLDR states for Arabic. Categories in ar that are not listed here hold the count-other form, which is the fallback LDML prescribes.",
              "type": "array",
              "items": {
                "enum": [
                  "zero",
                  "one",
                  "two",
                  "few",
                  "many",
                  "other"
                ]
              }
            },
            "en": {
              "type": "object",
              "properties": {
                "one": {
                  "type": "string",
                  "minLength": 1
                },
                "other": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "one",
                "other"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ar"
          ],
          "additionalProperties": false
        },
        "symbol": {
          "type": "object",
          "properties": {
            "standard": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "narrow": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "variant": {
              "$ref": "common.schema.json#/$defs/localized",
              "description": "CLDR alt=\"variant\" symbol."
            },
            "codeFallback": {
              "description": "Languages for which CLDR states no symbol, so standard holds the ISO code.",
              "type": "array",
              "items": {
                "enum": [
                  "ar",
                  "en"
                ]
              }
            },
            "byLocale": {
              "description": "ar-XX locales whose symbol differs from ar.",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "standard": {
                    "type": "string",
                    "minLength": 1
                  },
                  "narrow": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "glyph": {
              "type": "object",
              "properties": {
                "char": {
                  "type": "string",
                  "minLength": 1
                },
                "codepoint": {
                  "type": "string",
                  "pattern": "^U\\+[0-9A-F]{4,6}$"
                },
                "unicodeVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "char",
                "codepoint"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "standard"
          ],
          "additionalProperties": false
        },
        "minorUnits": {
          "description": "ISO 4217 decimal places.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "cldrFractions": {
          "description": "CLDR currencyData fractions: the decimals CLDR-based formatters (ICU, Intl) use, which can differ from ISO 4217. stated is false when CLDR has no entry and its DEFAULT applies.",
          "type": "object",
          "properties": {
            "digits": {
              "type": "integer"
            },
            "rounding": {
              "type": "integer"
            },
            "stated": {
              "type": "boolean"
            }
          },
          "required": [
            "digits",
            "rounding",
            "stated"
          ],
          "additionalProperties": false
        },
        "cash": {
          "type": "object",
          "properties": {
            "minorUnits": {
              "type": "integer"
            },
            "roundingIncrement": {
              "type": "number"
            },
            "stated": {
              "type": "boolean"
            },
            "smallestCoin": {
              "type": "number"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "CLDR cashDigits and cashRounding. roundingIncrement is in units of 10^-minorUnits, as in CLDR; 0 means no increment beyond the digits. stated is false when CLDR has no cash values and they default to the non-cash ones."
        },
        "subunit": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "plural": {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "object",
                  "properties": {
                    "zero": {
                      "type": "string",
                      "minLength": 1
                    },
                    "one": {
                      "type": "string",
                      "minLength": 1
                    },
                    "two": {
                      "type": "string",
                      "minLength": 1
                    },
                    "few": {
                      "type": "string",
                      "minLength": 1
                    },
                    "many": {
                      "type": "string",
                      "minLength": 1
                    },
                    "other": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "one",
                    "two",
                    "few",
                    "many",
                    "other"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "perUnit": {
              "type": "integer"
            },
            "others": {
              "description": "Further fractional units, each with how many make one unit.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "common.schema.json#/$defs/localized"
                  },
                  "perUnit": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "perUnit"
                ],
                "additionalProperties": false
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "perUnit"
          ],
          "additionalProperties": false
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "arabLeagueRegions": {
          "description": "The subset of regions that has a file in data/regions.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "fieldProvenance": {
          "description": "Fields whose method or confidence differs from the file-level provenance. The file-level values describe everything not listed here.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Dot path inside data."
              },
              "method": {
                "enum": [
                  "extracted",
                  "derived",
                  "researched",
                  "authored"
                ]
              },
              "confidence": {
                "$ref": "common.schema.json#/$defs/confidence"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/source"
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "method",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "name",
        "symbol",
        "minorUnits",
        "regions"
      ],
      "additionalProperties": false
    }
  }
}
