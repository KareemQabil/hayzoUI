{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library-api.schema.json",
  "title": "Library API surface",
  "description": "The public component API of one existing library, read from its published types. Facts about an API, not its code. File: data/catalog/libraries/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "library-api"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "library": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "homepage": {
              "type": "string",
              "format": "uri"
            },
            "kind": {
              "enum": [
                "styled",
                "headless",
                "copy-paste",
                "data-grid",
                "other"
              ]
            },
            "entryPoints": {
              "description": "Module specifiers whose exports were read.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "name",
            "package",
            "version",
            "license",
            "kind"
          ],
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "description": "Omitted for a component. namespace: an export that only groups parts and takes no props. interface: an options object (TableOptions, GridOptions, ColDef) recorded with the same prop shape. registry-item: an entry of a copy-paste registry.",
                "enum": [
                  "component",
                  "namespace",
                  "interface",
                  "registry-item"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Type file inside the package; prefixed with the package name when the declaration lives in a dependency."
              },
              "parts": {
                "description": "Sub-components, as the names of their own records (Dialog.Title), or — for a registry item — the component names its file exports.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "aliases": {
                "description": "Other exported names that resolve to this same component (DialogRoot for Dialog.Root).",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "propsType": {
                "description": "Name of the props type, when it has one.",
                "type": "string",
                "minLength": 1
              },
              "typeParameters": {
                "description": "Type parameters of a generic component or interface.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "default": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "deprecated": {
                      "type": "boolean"
                    },
                    "inheritedFrom": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Interface or type alias the prop is declared in, when that is not the component's own props type."
                    },
                    "declaredIn": {
                      "description": "npm package that declares the prop, when it is not the library itself.",
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "excluded": {
                "description": "Props counted but not recorded: dom — declared in React's typings, csstype or the DOM lib; style — members of the style-prop interfaces listed in data.styleProps.",
                "type": "object",
                "properties": {
                  "dom": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "style": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "dom",
                  "style"
                ],
                "additionalProperties": false
              },
              "registryDependencies": {
                "description": "Other registry items a copy-paste item needs.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependencies": {
                "description": "npm packages a copy-paste item declares.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "props"
            ],
            "additionalProperties": false,
            "description": "A component, a compound member (dotted name, e.g. Dialog.Root), a namespace that only groups members, an options interface of a table engine, or an item of a copy-paste registry."
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "components": {
              "type": "integer",
              "description": "Records that take props: components, compound members and interfaces. Namespaces are not counted."
            },
            "props": {
              "type": "integer"
            },
            "medianProps": {
              "description": "Median number of recorded props per counted record.",
              "type": "number",
              "minimum": 0
            },
            "families": {
              "description": "Distinct top-level export names.",
              "type": "integer",
              "minimum": 0
            },
            "namespaces": {
              "type": "integer",
              "minimum": 0
            },
            "interfaces": {
              "type": "integer",
              "minimum": 0
            },
            "aliases": {
              "description": "Exported names folded into another record.",
              "type": "integer",
              "minimum": 0
            },
            "excludedDomProps": {
              "type": "integer",
              "minimum": 0
            },
            "excludedStyleProps": {
              "type": "integer",
              "minimum": 0
            },
            "componentsAcceptingDomDir": {
              "description": "Components whose props include the DOM dir attribute through the excluded typings.",
              "type": "integer",
              "minimum": 0
            },
            "parts": {
              "description": "Component names exported by registry items.",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "components",
            "props"
          ],
          "additionalProperties": false
        },
        "styleProps": {
          "description": "Style-prop interfaces whose members were left out of every component and are listed once here.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "components": {
                "type": "integer",
                "minimum": 0
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "components",
              "props"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "library",
        "components",
        "stats"
      ],
      "additionalProperties": false
    }
  }
}
