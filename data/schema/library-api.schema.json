{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library-api.schema.json",
  "title": "Library API surface",
  "description": "The public component API of one existing library, read from its published types. Facts about an API, not its code. File: data/catalog/libraries/<id>.json.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "provenance",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "library-api"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "data": {
      "type": "object",
      "properties": {
        "library": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "homepage": {
              "type": "string",
              "format": "uri"
            },
            "kind": {
              "enum": [
                "styled",
                "headless",
                "copy-paste",
                "data-grid",
                "other"
              ]
            }
          },
          "required": [
            "name",
            "package",
            "version",
            "license",
            "kind"
          ],
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Type file inside the package."
              },
              "parts": {
                "description": "Sub-components or slots, e.g. Dialog.Title.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "default": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "deprecated": {
                      "type": "boolean"
                    },
                    "inheritedFrom": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "required"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "props"
            ],
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "components": {
              "type": "integer"
            },
            "props": {
              "type": "integer"
            }
          },
          "required": [
            "components",
            "props"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "library",
        "components",
        "stats"
      ],
      "additionalProperties": false
    }
  }
}
