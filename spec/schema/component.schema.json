{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hayzoui.dev/schema/component.json",
  "title": "Component spec",
  "description": "Source of truth for one component. State sheets, docs and tests are generated from it. Cross-references (rules, patterns, states, contracts) are checked by src/spec/spec.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "family", "maturity", "purpose", "anatomy", "props", "states", "content", "keyboard", "aria", "locale", "invariants", "contexts", "primitive", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "description": "Arabic display name" },
    "nameEn": { "type": "string" },
    "family": { "enum": ["actions", "inputs", "navigation", "feedback", "overlays", "data", "foundations"] },
    "tier": { "enum": ["T0", "T1", "T2", "T3", "T4"], "description": "Build order by dependency (MASTER_PLAN §7)" },
    "maturity": { "enum": ["planned", "draft", "alpha", "beta", "stable"] },
    "purpose": { "type": "string", "minLength": 10 },
    "whenToUse": { "type": "array", "items": { "type": "string" } },
    "whenNotToUse": { "type": "array", "items": { "type": "string" } },
    "anatomy": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "uniqueItems": true },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "doc"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "type": { "type": "string" },
          "default": {},
          "required": { "type": "boolean" },
          "doc": { "type": "string" }
        }
      }
    },
    "states": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "content": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "keyboard": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["key", "action"], "properties": { "key": { "type": "string" }, "when": { "type": "string" }, "action": { "type": "string" } } }
    },
    "aria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "labelling"],
      "properties": {
        "role": { "type": "string" },
        "labelling": { "type": "string" },
        "describedBy": { "type": "array", "items": { "type": "string" } },
        "live": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tokens": { "type": "object", "additionalProperties": { "type": "string" } },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeralsInput", "numeralsDisplay", "ltrIslands", "mirroredIcons"],
      "properties": {
        "numeralsInput": { "enum": ["all", "latn", "none"] },
        "numeralsDisplay": { "enum": ["provider", "latn", "none"] },
        "ltrIslands": { "type": "array", "items": { "type": "string" } },
        "mirroredIcons": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Internal strings with Arabic defaults" }
      }
    },
    "contracts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "statement": { "type": "string" }, "tests": { "type": "array", "items": { "type": "string" } } } }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "unsupported"],
      "properties": {
        "supported": { "type": "array", "items": { "type": "string" } },
        "unsupported": { "type": "array", "items": { "type": "string" } },
        "tested": { "description": "Generated from evidence records. Never written by hand.", "not": {} }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "relationship"],
      "properties": { "source": { "type": "string" }, "relationship": { "enum": ["original", "adapted", "integrated", "referenced"] }, "note": { "type": "string" } }
    },
    "rules": { "type": "array", "items": { "type": "string", "pattern": "^R-[A-Z0-9]+-\\d{3}$" }, "uniqueItems": true },
    "patterns": { "type": "array", "items": { "type": "string", "pattern": "^P-[A-Z-]+$" }, "uniqueItems": true }
  }
}
